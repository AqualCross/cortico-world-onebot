{
  "name": "cortico-world-onebot",
  "version": "0.3.0",
  "type": "module",
  "description": "让TA使用QQ。连接到你的napcat或者snowluma，然后在QQ上和TA聊天吧。就像直接用QQ一样，使用几乎所有功能。",
  "license": "MIT",
  "author": {
    "name": "AqualCross"
  },
  "homepage": "https://github.com/AqualCross/cortico-world-onebot#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AqualCross/cortico-world-onebot.git"
  },
  "bugs": {
    "url": "https://github.com/AqualCross/cortico-world-onebot/issues"
  },
  "keywords": [
    "cortico-world",
    "cortico",
    "coopanion",
    "onebot",
    "onebot-v11",
    "qq",
    "snowluma",
    "napcat",
    "llonebot",
    "lagrange"
  ],
  "engines": {
    "node": ">=22"
  },
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js"
  },
  "files": [
    "src",
    "tools/sync-catalog.mjs",
    "describe.json",
    "CHANGELOG.md",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "describe": "node tools/describe.mjs",
    "check": "node tools/check.mjs",
    "selfcheck": "node tools/check.mjs",
    "sync-catalog": "node tools/sync-catalog.mjs",
    "test": "node --test",
    "prepublishOnly": "node tools/check.mjs"
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "cortico": {
    "kind": "world",
    "api": 6,
    "displayName": "OneBot",
    "webUiClient": "src/webui/client.js",
    "tags": [
      "qq",
      "onebot"
    ],
    "describe": "describe.json"
  }
}
